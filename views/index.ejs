<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora Post</title>
</head>
<body>
    <h1>Quora- Update your post</h1>
    <% for (post of posts) { %>
        <h2>@<%= post.username %></h2>
        <h3>Content: <%= post.content  %></h3>
        <a href="http://localhost:8080/posts/<%= post.id  %>">See Post</a>
    <% } %>
    <br>
    <br>
    <a href="http://localhost:8080/posts/new">Add a new Post</a>
</body>
</html>